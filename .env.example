# ============================================================
# 康养智能体 runtime 配置示例
# 复制为 .env 并按需修改即可:  cp .env.example .env
# 无需修改也能以默认本地端点运行。
# ============================================================

# ---- LLM(Agent 大脑)----
# 默认连本地 OpenAI 兼容推理端点(vLLM / llama.cpp / minimax)
HEALTHCARE_LLM_PROVIDER=local
HEALTHCARE_LLM_BASE_URL=http://deepseek-v4-flash:8000/v1
HEALTHCARE_LLM_API_KEY=none
HEALTHCARE_LLM_MODEL=minimax
HEALTHCARE_LLM_MAX_TOKENS=2048
HEALTHCARE_LLM_THINKING=off

# ---- 领域服务(Guideline retrieval + Risk Calculator)----
# 需要先启动 Python 服务:  python scripts/service.py --rag data/rag
HEALTHCARE_DOMAIN_URL=http://127.0.0.1:8787
HEALTHCARE_RAG_DIR=data/rag

# ---- HTTP/SSE 服务 ----
HEALTHCARE_SERVER_HOST=127.0.0.1
HEALTHCARE_SERVER_PORT=4000

# ---- 专科医生自动生成 ----
HEALTHCARE_SPECIALIST_MODEL=minimax
HEALTHCARE_SPECIALIST_AUTOGEN=false
